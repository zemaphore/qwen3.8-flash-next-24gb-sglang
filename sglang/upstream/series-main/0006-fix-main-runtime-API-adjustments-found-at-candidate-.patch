From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: root <root@docker01.fra.askei.net>
Date: Wed, 16 Sep 2026 21:29:54 +0000
Subject: [PATCH 6/6] fix(main): runtime API adjustments found at candidate
 bring-up

Two port fixes surfaced by the first main-based boot on the 3090:

- qsa_indexer._qsa_ensure_rope: main retired get_global_server_args();
  read context_length from the model namespace bag (get_model().context_length).
- paged allocator _lazy_idle_check: main's PagedTokenToKVPoolAllocator has no
  release_pages list; the idle test is len(free_pages) + num_staged_pages >=
  num_pages, matching available_size().

With these, the port boots the promoted 230K profile and matches the frozen
control bit-exactly on the teacher-forced logprob oracle (MAX 0.0000 /
MEAN 0.00000 over 450 tokens).
---
 python/sglang/srt/layers/attention/qsa/qsa_indexer.py | 4 ++--
 python/sglang/srt/mem_cache/allocator/paged.py        | 6 ++++--
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/python/sglang/srt/layers/attention/qsa/qsa_indexer.py b/python/sglang/srt/layers/attention/qsa/qsa_indexer.py
index 677f24c0d8..7a65a111f3 100644
--- a/python/sglang/srt/layers/attention/qsa/qsa_indexer.py
+++ b/python/sglang/srt/layers/attention/qsa/qsa_indexer.py
@@ -31,9 +31,9 @@ def _qsa_ensure_rope(rotary_emb, positions):
     that once (a Python-side comparison afterwards) and fall back to the
     synchronizing path only if a position somehow exceeds it.
     """
-    from sglang.srt.server_args import get_global_server_args
+    from sglang.srt.runtime_context import get_model
 
-    ctx = int(getattr(get_global_server_args(), "context_length", 0) or 0)
+    ctx = int(getattr(get_model(), "context_length", 0) or 0)
     if ctx > 0:
         if int(rotary_emb.cos_sin_cache.shape[0]) <= ctx:
             rotary_emb._ensure_cos_sin_cache_length(ctx)
diff --git a/python/sglang/srt/mem_cache/allocator/paged.py b/python/sglang/srt/mem_cache/allocator/paged.py
index afa5ecf3cf..893267cfd9 100755
--- a/python/sglang/srt/mem_cache/allocator/paged.py
+++ b/python/sglang/srt/mem_cache/allocator/paged.py
@@ -173,9 +173,11 @@ class PagedTokenToKVPoolAllocator(BaseTokenToKVPoolAllocator):
             return False
 
     def _lazy_idle_check(self) -> None:
+        # Pool idle: every page is free (see available_size()). Main's allocator
+        # has no release_pages list; staged_pages covers the need_sort path.
         if (
-            len(self.free_pages) + len(self.release_pages) >= self.num_pages
-        ):  # pool idle: slot order + give memory back
+            len(self.free_pages) + self.num_staged_pages >= self.num_pages
+        ):
             kv = getattr(self._kvcache, "full_kv_pool", self._kvcache)
             release = getattr(kv, "lazy_release", None)
             if release is not None:
