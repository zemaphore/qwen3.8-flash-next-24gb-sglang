+    r = slots & RING_MASK
+    o = tl.load(owner + r, mask=valid, other=-1).to(tl.int64)
+    hot = valid & (o == slots)
+    cold = valid & (o != slots)
+    dst = ((pack_start + cols)[:, None] * heads + head) * dim + dims[None, :]
+    mask = valid[:, None] & (dims[None, :] < dim)
