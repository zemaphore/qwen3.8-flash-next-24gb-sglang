+@triton.jit
+def _gather_dequant_rows_tiered(
+    k,
+    v,
+    k_scale,
+    v_scale,
+    rk,
+    rv,
+    rks,
+    rvs,
+    owner,
+    sm_k,
+    sm_v,
+    req_to_token,
+    req_indices,
+    seq_lens,
+    cu_k,
+    out_k,
+    out_v,
